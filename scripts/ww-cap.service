[Unit]
Description=web-wayland 抓帧编码（screencopy + VAAPI，无会话自动休眠）
After=ww-session.service ww-gateway.service
Wants=ww-gateway.service

[Service]
Type=simple
# 清掉调用方带进来的私有库路径（IDE 终端注入的旧 libstdc++/libselinux）
Environment=LD_LIBRARY_PATH=
Environment=WW_ENC=vaapi
Environment=WW_MAX=3200x1800
# 启动器负责等 Wayland socket、建 headless 输出，再 exec wwcap
ExecStart=%h/gitWorkspace/web-wayland/scripts/ww-cap-start.sh
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
